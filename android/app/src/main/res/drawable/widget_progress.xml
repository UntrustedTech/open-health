<?xml version="1.0" encoding="utf-8"?>
<!-- A capsule bar; track and fill are tinted at runtime. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="4dp"/><solid android:color="@color/widget_track"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="4dp"/><solid android:color="#FFFFFFFF"/></shape></clip>
    </item>
</layer-list>
